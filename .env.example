# cp .env.example .env; change the two local passwords. Never commit .env.
POSTGRES_PASSWORD=replace_with_a_local_password
# VNC passwords use at most 8 characters. Replace this local placeholder.
NOVNC_PASSWORD=changeMe
# Public demo credentials only (not production accounts).
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
WEB_PORT=8080
API_PORT=8000
NOVNC_PORT=7900
RUN_TIMEOUT_SECONDS=180
MANUAL_TIMEOUT_SECONDS=90
LEASE_SECONDS=45
HEARTBEAT_SECONDS=10
SELENIUM_WAIT_SECONDS=12
ARCAPTCHA_CHECKBOX_SELECTOR="#arc-checkbox, #ar-checkbox"
ARCAPTCHA_USERNAME_SELECTOR=#email
ARCAPTCHA_PASSWORD_SELECTOR=#password
ARCAPTCHA_SUBMIT_SELECTOR=form button
# Legacy CHALLENGE/SOLVED/SUCCESS/FAILURE_SELECTOR settings are deprecated and ignored.
# Challenge: named widget getter / semantic DOM. Success: actual browser login JSON.

# Local JSONL diagnostics are opt-in; never stored in the run table.
ARCAPTCHA_DIAGNOSTICS_ENABLED=false
ARCAPTCHA_DIAGNOSTICS_DIRECTORY=diagnostics
